# Copy to /etc/debian-vendoos/vendo.env and change every secret.
BACKUP_DIR=/var/backups/debian-vendoos
PORT=3080
HOST=0.0.0.0
DATA_DIR=/var/lib/debian-vendoos
DB_FILE=/var/lib/debian-vendoos/vendo.db
CUSTOMER_IF=wlan0
WAN_IF=eth0
MANAGEMENT_CIDR=127.0.0.1/32
HOTSPOT_MODE=wifi
HOTSPOT_ADDRESS=10.88.0.1
HOTSPOT_CIDR=10.88.0.1/24
HOTSPOT_PREFIX=24
HOTSPOT_NETMASK=255.255.255.0
DHCP_START=10.88.0.20
DHCP_END=10.88.0.250
DHCP_LEASE=12h
SSID=VendoOS-WiFi
WIFI_CHANNEL=6
WIFI_COUNTRY=PH
PORTAL_URL=http://10.88.0.1:3080/
ADMIN_PASSWORD=replace-with-at-least-12-characters
PROVISION_KEY=replace-with-at-least-16-characters
COIN_LEASE_SECONDS=60
HARDWARE_ONLINE_SECONDS=90
# Optional PayMongo hosted checkout. Keep live keys only in /etc/debian-vendoos/vendo.env.
# PAYMONGO_SECRET_KEY=sk_test_replace-me
# PAYMONGO_WEBHOOK_SECRET=whsk_replace-me
# PAYMONGO_RETURN_BASE_URL=https://wifi.example.com
# Optional encrypted offsite copy of each daily database backup. Configure a pinned SSH host key.
# OFFSITE_BACKUP_SSH_TARGET=backup-user@backup.example.com
# OFFSITE_BACKUP_PATH=/srv/vendoos-backups
# OFFSITE_BACKUP_SSH_KEY=/etc/debian-vendoos/offsite-backup-key
# OFFSITE_BACKUP_ENCRYPTION_KEY_FILE=/etc/debian-vendoos/offsite-backup-passphrase
